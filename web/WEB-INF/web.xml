<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    <servlet>
        <servlet-name>SkierServlet</servlet-name>
        <servlet-class>assignment1.server.SkierServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>SkierServlet</servlet-name>
        <url-pattern>/skiers1/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SkierServlet2</servlet-name>
        <servlet-class>assignment2.server.SkierServlet2</servlet-class>

    </servlet>

    <servlet-mapping>
        <servlet-name>SkierServlet2</servlet-name>
        <url-pattern>/skiers2/*</url-pattern>
    </servlet-mapping>


</web-app>